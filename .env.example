# Optional. MapLibre Carto Dark Matter is the default basemap (no token).
# NEXT_PUBLIC_MAPBOX_TOKEN=

# PostGIS (EPSG:2326 authority). Local default matches docker-compose.yml.
# DATABASE_URL=postgres://aeris:aeris@127.0.0.1:5432/aeris

# Optional Neon claimable archive for decade episodes + policy audit + Drizzle
# snapshot tables (buildings, simulation_runs, hourly_cluster_metrics).
# Do not commit secrets. Use the pooled (-pooler) connection string for HTTP.
# NEON_DATABASE_URL=
# NEON_CLAIM_URL=

# Spatial Policy Copilot (POST /api/agent). Without a key the deterministic
# intent parser still plans all four tools. Neon AI Gateway is tried first.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AGENT_MODEL=gpt-4o-mini
# NEON_AI_GATEWAY_TOKEN=
# NEON_AI_GATEWAY_BASE_URL=
